def split_region(x, y, width, height, min_size):

    if width < min_size or height < min_size:
        return
    
    half_w = width // 2
    half_h = height // 2
    
    split_region(x, y, half_w, half_h, min_size)
    split_region(x + half_w, y, half_w, half_h, min_size)
    split_region(x, y + half_h, half_w, half_h, min_size)
    split_region(x + half_w, y + half_h, half_w, half_h, min_size)


def count_points_in_region(points, region):
 
    count = 0
    x0 = region['x']
    y0 = region['y']
    w = region['width']
    h = region['height']
    
    for point in points:
        if x0 <= point['x'] <= x0 + w and y0 <= point['y'] <= y0 + h:
            count += 1
    
    return count


def find_dense_regions(points, x, y, width, height, min_size, density_threshold):

    region = {'x': x, 'y': y, 'width': width, 'height': height}
    
    count = count_points_in_region(points, region)
    area = width * height
    density = count / area if area > 0 else 0
    
    result = []
    
    if density > density_threshold:
        result.append(region)
    
    if width >= min_size and height >= min_size:
        half_w = width // 2
        half_h = height // 2
        
        result.extend(find_dense_regions(points, x, y, half_w, half_h, min_size, density_threshold))
        result.extend(find_dense_regions(points, x + half_w, y, half_w, half_h, min_size, density_threshold))
        result.extend(find_dense_regions(points, x, y + half_h, half_w, half_h, min_size, density_threshold))
        result.extend(find_dense_regions(points, x + half_w, y + half_h, half_w, half_h, min_size, density_threshold))
    
    return result


